{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  "logo": {
    "type": "builtin",
    "source": "Arch",

    "padding": {
      "top": 0,
      "left": 0,
      "right": 2
    },

    // Phosphor cyan and purple.
    "color": {
      "1": "#7DD3FC",
      "2": "#A78BFA"
    }
  },

  "display": {
    "separator": " ",
    "color": "#E2E8F0"
  },

  "modules": [
    {
      // Restrained palette preview:
      // slate, coral, green, amber, cyan and purple.
    "type": "custom",
    "format": "{##94A3B8}  {##FB7185}  {##86EFAC}  {##FBBF24}  {##7DD3FC}  {##A78BFA}{#}"
    },

    "break",

    {
      "type": "title",
      "keyWidth": 10,
      "keyColor": "#7DD3FC",
      "outputColor": "#A78BFA"
    },

    "break",

    {
      "type": "os",
      "key": " ",
      "keyColor": "#7DD3FC",
      "outputColor": "#E2E8F0"
    },
    {
      "type": "kernel",
      "key": " ",
      "keyColor": "#7DD3FC",
      "outputColor": "#E2E8F0"
    },
    {
      "type": "packages",
      "key": " ",
      "keyColor": "#7DD3FC",
      "outputColor": "#E2E8F0",
      "format": "{pacman} (pacman) {flatpak-all} (flatpak)"
    },
    {
      "type": "shell",
      "key": " ",
      "keyColor": "#7DD3FC",
      "outputColor": "#E2E8F0"
    },
    {
      "type": "terminal",
      "key": " ",
      "keyColor": "#7DD3FC",
      "outputColor": "#E2E8F0"
    },
    {
      "type": "wm",
      "key": " ",
      "keyColor": "#A78BFA",
      "outputColor": "#E2E8F0"
    },
    {
      "type": "display",
      "key": " ",
      "keyColor": "#A78BFA",
      "outputColor": "#E2E8F0"
    },
    {
      "type": "cpu",
      "key": "󰻠 ",
      "keyColor": "#86EFAC",
      "outputColor": "#E2E8F0",
      "format": "{1}"
    },
    {
      "type": "gpu",
      "key": "󰍹 ",
      "keyColor": "#86EFAC",
      "outputColor": "#E2E8F0",
      "format": "{2}"
    },
    {
      "type": "gpu",
      "key": " ",
      "keyColor": "#86EFAC",
      "outputColor": "#E2E8F0",
      "format": "{3}"
    },
    {
      "type": "memory",
      "key": "󰑭 ",
      "keyColor": "#86EFAC",
      "outputColor": "#E2E8F0"
    },
    {
      "type": "disk",
      "key": "󰋊 ",
      "keyColor": "#FBBF24",
      "outputColor": "#E2E8F0",
      "format": "{mount-from} - {size-used} / {size-total} ({size-percentage})"
    },
    {
      "type": "uptime",
      "key": " ",
      "keyColor": "#A78BFA",
      "outputColor": "#E2E8F0"
    },
    {
      "type": "command",
      "key": "󱦟 ",
      "keyColor": "#A78BFA",
      "outputColor": "#94A3B8",
      "text": "birth_install=$(stat -c %W /); current=$(date +%s); time_progression=$((current - birth_install)); days_difference=$((time_progression / 86400)); printf '%s days\\n' \"$days_difference\""
    },

    "break",

    {
        "type": "custom",
        "format": "{##94A3B8}  {##FB7185}  {##86EFAC}  {##FBBF24}  {##7DD3FC}  {##A78BFA}{#}"
    },

    "break",
    "break"
  ]
}
